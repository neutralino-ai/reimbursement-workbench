{
  "name": "reimbursement-workbench",
  "version": "0.3.12",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node scripts/frontend-server.mjs",
    "start": "node scripts/frontend-server.mjs",
    "build": "vite build --base=/",
    "typecheck": "tsc --noEmit",
    "desktop:dev": "pnpm build && electron desktop/main.cjs",
    "desktop:win": "pnpm build && node scripts/package-desktop.mjs --win",
    "desktop:mac": "pnpm build && node scripts/package-desktop.mjs --mac --arm64",
    "desktop:mac:intel": "pnpm build && node scripts/package-desktop.mjs --mac",
    "test": "node --test tests/*.test.mjs",
    "ios:sync": "pnpm build && cap sync ios && node scripts/prepare-ios.mjs && node scripts/verify-ios.mjs",
    "ios:open": "cap open ios",
    "ios:check": "node scripts/verify-ios.mjs",
    "ios:build": "node scripts/build-ios.mjs",
    "ios:archive": "node scripts/build-ios.mjs --archive",
    "desktop:mac:release": "pnpm build && node scripts/package-desktop.mjs --mac --arm64 --release && node scripts/verify-desktop-package.mjs --mac --arm64 && node scripts/verify-mac-release.mjs --arm64"
  },
  "dependencies": {
    "@capacitor/core": "8.5.2",
    "@capacitor/ios": "8.5.2",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "electron": "44.4.1",
    "electron-builder": "26.15.3",
    "typescript": "7.0.2",
    "vite": "8.3.0"
  }
}
