[Unit]
Description=Reimbursement HTTPS API on port 29375
After=network.target reimbursement.service
Wants=reimbursement.service

[Service]
Type=simple
RuntimeDirectory=reimbursement-api
RuntimeDirectoryMode=0755
LogsDirectory=reimbursement-api
LogsDirectoryMode=0750
ExecStartPre=/usr/sbin/nginx -t -c /etc/reimbursement/nginx-api.conf
ExecStart=/usr/sbin/nginx -c /etc/reimbursement/nginx-api.conf -g "daemon off;"
ExecReload=/bin/kill -HUP $MAINPID
KillSignal=SIGQUIT
TimeoutStopSec=20
Restart=on-failure
RestartSec=3
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/run/reimbursement-api /var/log/reimbursement-api
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
